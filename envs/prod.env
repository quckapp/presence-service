# =============================================================================
# PRESENCE SERVICE - Production Environment
# =============================================================================

# Application
MIX_ENV=prod
PORT=4000
PHX_HOST=quckapp.com
PHX_SERVER=true

# Security (Use secrets management - AWS Secrets Manager, Vault, etc.)
SECRET_KEY_BASE=${SECRET_KEY_BASE}
JWT_SECRET=${JWT_SECRET}

# MongoDB (Use MongoDB Atlas or managed MongoDB)
MONGODB_URL=${MONGODB_URL}

# Redis (Use ElastiCache or managed Redis)
REDIS_URL=${REDIS_URL}

# Kafka (Use MSK or managed Kafka)
KAFKA_BROKERS=${KAFKA_BROKERS}

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8081

# Erlang Distribution
RELEASE_COOKIE=${ERLANG_COOKIE}
NODE_NAME=presence@${HOSTNAME}

# Observability
JAEGER_ENDPOINT=${JAEGER_ENDPOINT}
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=true

# Performance
POOL_SIZE=20
